{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crazy-thursday",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // quotes.txt 以「纯文本模块」方式打进 Worker：改文件 -> 重新部署即生效
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],

  // public/ 作为静态资源；/api/* 先交给 Worker
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // 每周四 09:00 北京时间（= 01:00 UTC）触发，若配置了 WEBHOOK_URL 就推一条文案
  "triggers": { "crons": ["0 1 * * 4"] },

  // 「笑到了」点赞与热门排行：KV 全局永久计数（未绑定时自动退化为 Cache API）
  "kv_namespaces": [{ "binding": "QUOTES_KV", "id": "25e74eabfc65473fad1ae659e849dcf9" }],

  "observability": { "enabled": true }
}
